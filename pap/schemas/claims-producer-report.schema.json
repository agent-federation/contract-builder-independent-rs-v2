{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pap:0.1:producer-report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "papClaimsVersion",
    "producer",
    "claims"
  ],
  "properties": {
    "papClaimsVersion": {
      "const": "0.1"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "checkVersion",
          "claimedOutcome"
        ],
        "properties": {
          "checkId": {
            "type": "string",
            "pattern": "^pap\\.check\\.[a-z0-9-]+/[0-9]+$"
          },
          "checkVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "claimedOutcome": {
            "enum": [
              "PASS",
              "FAIL",
              "UNSUPPORTED",
              "NOT_EVALUATED"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "checker": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "implementationDigest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "implementationDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
