{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pap:0.1:claims-reviews",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "papClaimsVersion",
    "approvals"
  ],
  "properties": {
    "papClaimsVersion": {
      "const": "0.1"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reviewer",
          "decision",
          "decidedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reviewer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity"
            ],
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
              },
              "keyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "packageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "packageIdentity": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 255
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
