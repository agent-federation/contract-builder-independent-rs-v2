{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pap:0.1:claims-provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "papClaimsVersion",
    "bindings"
  ],
  "properties": {
    "papClaimsVersion": {
      "const": "0.1"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entityId",
          "sourceId",
          "locator",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "start",
              "end"
            ],
            "properties": {
              "kind": {
                "const": "byte-range"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "quote": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "normalization",
              "digest"
            ],
            "properties": {
              "normalization": {
                "const": "none"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
