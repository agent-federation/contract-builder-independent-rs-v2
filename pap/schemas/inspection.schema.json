{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pap:0.1:inspection",
  "title": "Portable Assurance Package v0.1 inspection document",
  "type": "object",
  "additionalProperties": false,
  "required": ["inspectionVersion", "verifier", "package", "declared", "identities", "inspection", "limitations"],
  "properties": {
    "inspectionVersion": { "const": "0.1" },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementationDigest", "checkerIdentities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "implementationDigest": { "$ref": "#/$defs/digest" },
        "checkerIdentities": { "type": "array", "items": { "$ref": "#/$defs/digest" } }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "papVersion", "path"],
      "properties": {
        "identity": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "papVersion": { "type": ["string", "null"] },
        "path": { "type": "string" }
      }
    },
    "declared": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "declared", "computed"],
        "properties": {
          "kind": { "enum": ["artifact", "input", "source", "claim", "signature"] },
          "id": { "type": "string" },
          "path": { "type": "string" },
          "declared": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
          "computed": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageIdentity", "artifacts", "sources", "normalizedInputDigest", "extensionClosureDigest", "checkerIdentity"],
      "properties": {
        "packageIdentity": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "declared", "computed"],
            "properties": {
              "id": { "type": "string" },
              "declared": { "$ref": "#/$defs/digest" },
              "computed": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "declared", "computed"],
            "properties": {
              "id": { "type": "string" },
              "declared": { "$ref": "#/$defs/digest" },
              "computed": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
            }
          }
        },
        "normalizedInputDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "extensionClosureDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "checkerIdentity": { "$ref": "#/$defs/digest" }
      }
    },
    "inspection": { "enum": ["COMPLETE", "PARTIAL", "INVALID", "UNSUPPORTED"] },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": { "type": "string", "pattern": "^pap\\.[a-z0-9.-]+$" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
