{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pap:0.1:assurance-package",
  "title": "Portable Assurance Package v0.1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "papVersion",
    "package",
    "artifacts",
    "checkSpecs"
  ],
  "properties": {
    "papVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "createdAt": {
          "$ref": "#/$defs/rfc3339"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "manifestVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "normalizedInputDigest": {
          "$ref": "#/$defs/digest"
        },
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "version"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "profile",
                  "adapter",
                  "renderer",
                  "checker"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "mediaType",
          "bytes",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "allOf": [
              {
                "type": "string",
                "$ref": "#/$defs/path"
              },
              {
                "type": "string",
                "pattern": "^artifacts/"
              }
            ]
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "mediaType",
          "digest",
          "normalization"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "allOf": [
              {
                "type": "string",
                "$ref": "#/$defs/path"
              },
              {
                "type": "string",
                "pattern": "^inputs/"
              }
            ]
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "normalization": {
            "enum": [
              "lf",
              "none"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mediaType",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "allOf": [
              {
                "type": "string",
                "$ref": "#/$defs/path"
              },
              {
                "type": "string",
                "pattern": "^sources/"
              }
            ]
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "acquiredAt": {
            "$ref": "#/$defs/rfc3339"
          },
          "acquisition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "uri": {
                "type": "string",
                "maxLength": 2048
              },
              "revision": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/claimRef"
        },
        "relations": {
          "$ref": "#/$defs/claimRef"
        },
        "producerReport": {
          "$ref": "#/$defs/claimRef"
        },
        "reviews": {
          "$ref": "#/$defs/claimRef"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "closureDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "checkSpecs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/checkId"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "critical"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "critical": {
            "type": "boolean"
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "requiredFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^pap\\.[a-z0-9.-]+$"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkId": {
      "type": "string",
      "pattern": "^pap\\.check\\.[a-z0-9-]+/[0-9]+$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "path": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+){1,15}$"
    },
    "claimRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "allOf": [
            {
              "type": "string",
              "$ref": "#/$defs/path"
            },
            {
              "type": "string",
              "pattern": "^claims/"
            }
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
