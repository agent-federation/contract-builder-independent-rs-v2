{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pap:0.1:trust-policy",
  "title": "Portable Assurance Package v0.1 trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trustPolicyVersion",
    "id",
    "issuedAt",
    "expiresAt",
    "signature",
    "keys",
    "signers",
    "checkers",
    "profiles",
    "requiredChecks",
    "requiredDimensions",
    "humanReview"
  ],
  "properties": {
    "trustPolicyVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "issuedAt": {
      "$ref": "#/$defs/rfc3339"
    },
    "expiresAt": {
      "$ref": "#/$defs/rfc3339"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "disabled",
            "optional",
            "required"
          ]
        },
        "minimumValidSigners": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 1
        }
      }
    },
    "keys": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "publicKey"
        ],
        "properties": {
          "keyId": {
            "$ref": "#/$defs/keyId"
          },
          "algorithm": {
            "const": "ed25519"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      }
    },
    "signers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyIds",
          "identity",
          "allowedRoles"
        ],
        "properties": {
          "keyIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/keyId"
            }
          },
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "allowedRoles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "producer",
                "reviewer"
              ]
            }
          },
          "allowedPackageIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/packageId"
            }
          },
          "allowedPackageIdentities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    },
    "checkers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "implementationDigest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "implementationDigest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "closureDigest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/checkId"
      }
    },
    "requiredDimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "maxAgeSeconds"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "manifestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "payloadFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "fileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "totalPayloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "pathSegments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "pathBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "segmentBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "jsonNesting": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "jsonStringBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "claimsFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "provenanceBindings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "relationEntities": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "relationEdges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "signatureEnvelopes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "required"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "minItems": 1
          },
          "signers": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkId": {
      "type": "string",
      "pattern": "^pap\\.check\\.[a-z0-9-]+/[0-9]+$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "dimension": {
      "enum": [
        "integrity",
        "integrity.package",
        "integrity.artifacts",
        "sources",
        "sources.integrity",
        "sources.availability",
        "signature",
        "signature.validity",
        "trust",
        "trust.signerIdentity",
        "trust.policyDecision",
        "trust.checkerRecognition",
        "trust.profileRecognition",
        "checks",
        "humanReview"
      ]
    }
  }
}
